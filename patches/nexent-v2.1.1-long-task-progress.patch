+@pytest.mark.asyncio
+async def test_agent_run_yields_visible_progress_keepalive_during_idle_tool_wait(basic_agent_run_info, monkeypatch):
+    """Long-running tools should keep the stream alive with task-detail progress."""
+    basic_agent_run_info.observer.get_cached_message.side_effect = [[], []]
+
+    async def fast_sleep(duration):  # pylint: disable=unused-argument
+        return None
+
+    monkeypatch.setattr(run_agent.asyncio, "sleep", fast_sleep)
+    monkeypatch.setattr(run_agent, "SSE_KEEPALIVE_INTERVAL_SECONDS", 0.0)
+
+    class FakeThread:
+        def __init__(self, target=None, args=None):  # pylint: disable=unused-argument
+            self._alive_checks = 0
+
+        def start(self):
+            return None
+
+        def is_alive(self):
+            self._alive_checks += 1
+            return self._alive_checks == 1
+
+    monkeypatch.setattr(run_agent, "Thread", FakeThread)
+
+    received = []
+    async for item in run_agent.agent_run(basic_agent_run_info):
+        received.append(item)
+
+    assert len(received) == 1
+    heartbeat = run_agent.json.loads(received[0])
+    assert heartbeat["type"] == "model_output_thinking"
+    assert "[Progress]" in heartbeat["content"]
+    assert "results will return automatically" in heartbeat["content"]
+
