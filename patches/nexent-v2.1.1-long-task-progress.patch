+def _coalesce_cached_messages(messages: list[str]) -> list[str]:
+    """Merge adjacent text stream fragments before sending them to the browser."""
+    output: list[str] = []
+    pending: dict | None = None
+
+    def flush_pending() -> None:
+        nonlocal pending
+        if pending is not None:
+            output.append(json.dumps(pending, ensure_ascii=False))
+            pending = None
+
+    for message in messages:
+        try:
+            payload = json.loads(message)
+        except (TypeError, json.JSONDecodeError):
+            flush_pending()
+            output.append(message)
+            continue
+        message_type = payload.get("type")
+        content = payload.get("content")
+        if (
+            message_type in STREAM_COALESCE_TYPES
+            and isinstance(content, str)
+            and set(payload) <= {"type", "content"}
+        ):
+            if pending and pending["type"] == message_type:
+                pending["content"] += content
+            else:
+                flush_pending()
+                pending = {"type": message_type, "content": content}
+            continue
+        flush_pending()
+        output.append(message)
+    flush_pending()
+    return output
 
 
