# Optional. Without it, literature retrieval falls back when possible.
SEMANTIC_SCHOLAR_API_KEY=

# MCP server deployment. Use localhost for browser downloads on the same host.
PAPER_AGENT_ADVERTISED_HOST=localhost
PAPER_AGENT_HOST=0.0.0.0
PAPER_AGENT_PORT=8001
